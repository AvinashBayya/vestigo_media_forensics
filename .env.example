# Copy to .env to override defaults. Every setting is optional; the values below are the defaults.
# Milestone 1 needs no secrets.

VESTIGO_DATA_DIR=data
VESTIGO_MAX_UPLOAD_BYTES=52428800
VESTIGO_MAX_IMAGE_PIXELS=100000000
VESTIGO_PHASH_MAX_DISTANCE=10
VESTIGO_JOB_MODE=thread
VESTIGO_JOB_WORKERS=2
VESTIGO_TOOL_TIMEOUT_SECONDS=60
VESTIGO_OCR_TIMEOUT_SECONDS=120
VESTIGO_CORS_ORIGINS=["http://localhost:5180","http://127.0.0.1:5180"]
VESTIGO_LOG_LEVEL=INFO
